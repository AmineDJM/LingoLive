{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "LingoLive React Native",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}

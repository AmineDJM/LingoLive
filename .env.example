# =============================================================================
# LingoLive — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` (`pnpm bootstrap` does this for you) and fill in.
# NEVER commit a filled-in .env. Every value here is a placeholder.
#
# Legend:
#   [required]        server refuses to boot without it
#   [required:prod]   required only when APP_ENV=staging|production
#   [optional]        feature is disabled/mocked when absent
#   [public]          value IS shipped to clients — never put a secret here
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development                  # development | test | production
APP_ENV=development                   # development | test | staging | production
LOG_LEVEL=info                        # trace | debug | info | warn | error | fatal
PORT=4000                             # API listen port

# -----------------------------------------------------------------------------
# URLs — used for CORS, deep links, canonical SEO tags and QR payloads
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
DEEP_LINK_SCHEME=lingolive
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# -----------------------------------------------------------------------------
# Data stores [required]
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://lingolive:lingolive@localhost:5432/lingolive?schema=public
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Cryptography [required]
# Generate with: node infra/scripts/generate-secrets.mjs
# -----------------------------------------------------------------------------
# HMAC key used to sign session/participant tokens. >= 32 chars.
SESSION_SIGNING_SECRET=dev-only-session-signing-secret-change-me-32chars
# AES-256-GCM key for transcript/translation at-rest encryption.
# 32 bytes, base64-encoded. Rotating: see docs/SECURITY.md#key-rotation
TRANSCRIPT_ENCRYPTION_KEY=ZGV2LW9ubHktMzJieXRlLWtleS1kby1ub3QtdXNlISE=
TRANSCRIPT_ENCRYPTION_KEY_VERSION=1

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# `mock` runs the entire product without any OpenAI account (deterministic
# fixtures). `openai` requires OPENAI_API_KEY. Production refuses `mock`.
AI_PROVIDER=mock                      # mock | openai

# [required:prod] SERVER-SIDE ONLY. Never expose via NEXT_PUBLIC_/EXPO_PUBLIC_.
OPENAI_API_KEY=
# Realtime transcription model. Verify the current identifier in the OpenAI
# Realtime docs before switching AI_PROVIDER=openai.
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Text translation model. Intentionally has NO default: set it to the model
# identifier that is current and stable for your account at deploy time.
OPENAI_TRANSLATION_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_URL=https://api.openai.com/v1/realtime
# Seconds an ephemeral client secret stays valid. Keep short.
REALTIME_TOKEN_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Authentication
# `local` = development-only signed guest/dev tokens, no external provider.
# -----------------------------------------------------------------------------
AUTH_PROVIDER=local                   # local | oidc
AUTH_SECRET=dev-only-auth-secret-change-me-please-32c
AUTH_PUBLIC_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=lingolive
AUTH_JWKS_URL=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Admin console. Comma-separated e-mails granted the ADMIN role on sign-in.
# In `local` auth mode this also enables the seeded admin account.
ADMIN_EMAILS=admin@lingolive.local
# Extra shared secret required by every /api/v1/admin/* call (defence in depth).
ADMIN_API_TOKEN=dev-only-admin-token-change-me

# -----------------------------------------------------------------------------
# Quotas & cost controls (all configurable, none hard-coded in product code)
# -----------------------------------------------------------------------------
GUEST_MINUTES_PER_MONTH=30
FREE_MINUTES_PER_MONTH=120
PRO_MINUTES_PER_MONTH=6000
MAX_PERSONAL_SESSION_MINUTES=180
MAX_DISCUSSION_LANGUAGES=4
MAX_BUSINESS_TARGET_LANGUAGES=12
SESSION_IDLE_TIMEOUT_SECONDS=180
DAILY_COST_LIMIT_USD=50
MONTHLY_COST_LIMIT_USD=800
COST_CIRCUIT_BREAKER_ENABLED=true

# -----------------------------------------------------------------------------
# Data retention (days). See docs/PRIVACY.md
# -----------------------------------------------------------------------------
RETENTION_UNSAVED_SESSION_HOURS=1
RETENTION_BUSINESS_SESSION_DAYS=7
RETENTION_TECHNICAL_LOG_DAYS=30
BUSINESS_CODE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Observability [optional] — everything works with these empty
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_ENABLED=false

# -----------------------------------------------------------------------------
# Billing [optional] — absent keys ⇒ sandbox/mock entitlements, no real charges
# -----------------------------------------------------------------------------
BILLING_PROVIDER=mock                 # mock | stripe | revenuecat
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# -----------------------------------------------------------------------------
# [public] Web client — bundled into the browser. Secrets are forbidden here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# -----------------------------------------------------------------------------
# [public] Mobile client — bundled into the app. Secrets are forbidden here.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=

# -----------------------------------------------------------------------------
# Store / build identity (kept configurable — nothing is assumed reserved)
# -----------------------------------------------------------------------------
APP_DISPLAY_NAME=LingoLive
IOS_BUNDLE_IDENTIFIER=com.lingolive.app
ANDROID_PACKAGE=com.lingolive.app
EAS_PROJECT_ID=
EXPO_OWNER=
APPLE_TEAM_ID=
APPLE_ID=
ASC_APP_ID=
ANDROID_SERVICE_ACCOUNT_KEY_PATH=./google-play-service-account.json

# -----------------------------------------------------------------------------
# Development-only switches. Force-disabled when APP_ENV=production.
# -----------------------------------------------------------------------------
ENABLE_DEV_SIMULATOR=true             # internal LingoBusiness organizer simulator
ENABLE_REQUEST_LOGGING=true
